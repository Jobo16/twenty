# Image overrides for the SCRM local development infrastructure
# (packages/twenty-docker/docker-compose.dev.yml: PostgreSQL + Redis).
#
# Copy this file to .env.scrm.local, which is ignored by Git, and replace the
# values with complete image references your network can pull. Each variable is
# a whole reference: the registry path, repository, and tag or digest all belong
# to the value.
#
# Use image references only. Never commit registry credentials, an
# organization-specific registry hostname, or a shared public mirror endpoint;
# test and production environments must pin immutable tags or digests instead.
#
# The values below are the defaults the Compose file uses when no override file
# is present.

SCRM_POSTGRES_IMAGE=postgres:16
SCRM_REDIS_IMAGE=redis:7
