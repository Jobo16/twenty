# Copy this file to .env on the test or production host. The .env file is
# ignored by Git and must be populated from the environment's secret manager.
# Do not put real credentials in this template.

# Use a full reference from the approved private registry. Production should
# use a digest, or an immutable release tag that resolves to one.
SCRM_APP_IMAGE=registry.example.invalid/scrm/app:replace-with-release
SCRM_PROXY_IMAGE=registry.example.invalid/scrm/caddy:replace-with-approved-version

# A public DNS name that already resolves to this host before Caddy starts.
SCRM_PUBLIC_HOST=scrm.example.com
SCRM_TLS_EMAIL=ops@example.com
SERVER_URL=https://scrm.example.com

# Managed PostgreSQL 16 and Redis 7. Use TLS URLs when the provider requires it.
PG_DATABASE_URL=postgresql://replace-user:replace-password@postgres.example.invalid:5432/scrm
REDIS_URL=rediss://:replace-password@redis.example.invalid:6380/0

# Encrypting existing data requires stable keys. Rotate through the documented
# application procedure; do not replace an active key without retaining it as
# FALLBACK_ENCRYPTION_KEY first.
ENCRYPTION_KEY=replace-with-a-secret-manager-value
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=replace-with-a-secret-manager-value

# Managed S3-compatible object storage. It is required for this topology;
# the application host does not retain business files locally.
STORAGE_TYPE=s3
STORAGE_S3_REGION=replace-region
STORAGE_S3_NAME=replace-bucket
STORAGE_S3_ENDPOINT=https://object-storage.example.invalid
STORAGE_S3_ACCESS_KEY_ID=replace-with-a-secret-manager-value
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-a-secret-manager-value
STORAGE_S3_PRESIGNED_URL_ENABLED=true
STORAGE_S3_PRESIGNED_URL_BASE=https://object-storage.example.invalid
STORAGE_S3_PRESIGNED_URL_EXPIRES_IN=900

# Keep the initial product deployment focused on SCRM rather than upstream
# billing and prefilled development accounts.
IS_BILLING_ENABLED=false
SIGN_IN_PREFILLED=false
APPLICATION_LOG_DRIVER=CONSOLE
