#!/usr/bin/env bash
#
# Runs the Yarn release vendored in this repository so that a global `yarn`
# installation is not required. The release path is read from .yarnrc.yml
# instead of being repeated here, because that file owns the Yarn version.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

command -v node >/dev/null 2>&1 || {
  echo "Node.js is required to run Yarn; see .nvmrc for the required version." >&2
  exit 1
}

yarn_path="$(
  node -e '
    const { readFileSync } = require("node:fs");
    const yarnPath = readFileSync(".yarnrc.yml", "utf8").match(/^yarnPath:\s*(\S+)\s*$/m);
    if (yarnPath === null) {
      process.stderr.write("yarnPath is not defined in .yarnrc.yml.\n");
      process.exit(1);
    }
    process.stdout.write(yarnPath[1]);
  '
)"

if [[ ! -f "$yarn_path" ]]; then
  echo "The vendored Yarn release $yarn_path is missing; restore it from Git." >&2
  exit 1
fi

exec node "$yarn_path" "$@"
